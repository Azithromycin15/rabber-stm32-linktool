# Makefile for STM32F407ZGT6 HAL Template
# Generated by rabber mcu_init v1.3.2
# Target: cortex-m4 (armv7e-m), 1024KB Flash, 192KB RAM

# ── Toolchain ──
CC      = arm-none-eabi-gcc
OBJCOPY = arm-none-eabi-objcopy
OBJDUMP = arm-none-eabi-objdump
SIZE    = arm-none-eabi-size
GDB     = arm-none-eabi-gdb

# ── Target MCU ──
MCU      = STM32F407ZGT6
CPU      = cortex-m4
FPU      = fpv4-sp-d16

# ── Directories ──
BUILD_DIR   = build
PROCESS_DIR = process
SRC_DIR     = src
INC_DIR     = include

# ── Source files ──
C_SRCS   = $(wildcard $(SRC_DIR)/*.c)
ASM_SRCS = $(wildcard $(SRC_DIR)/*.s)
OBJS     = $(C_SRCS:$(SRC_DIR)/%.c=$(PROCESS_DIR)/%.o) \
           $(ASM_SRCS:$(SRC_DIR)/%.s=$(PROCESS_DIR)/%.o)

# ── Output ──
TARGET   = $(BUILD_DIR)/stm32f407zgt6
ELF      = $(TARGET).elf
HEX      = $(TARGET).hex
BIN      = $(TARGET).bin

# ── Compiler flags ──
CFLAGS  = -mcpu=cortex-m4
CFLAGS += -march=armv7e-m
CFLAGS += -mthumb
CFLAGS += -mfpu=fpv4-sp-d16 -mfloat-abi=hard
CFLAGS += -std=gnu11
CFLAGS += -Wall -Wextra -Werror
CFLAGS += -Os -g3 -ggdb
CFLAGS += -ffunction-sections -fdata-sections
CFLAGS += -fno-common
CFLAGS += -DSTM32F407ZGT6

# ── Includes ──
INCLUDES = -I$(INC_DIR)

# ── Linker flags ──
LDSCRIPT = STM32F407ZGT6_FLASH.ld
LDFLAGS  = -T$(LDSCRIPT)
LDFLAGS += -mcpu=cortex-m4
LDFLAGS += -mthumb
LDFLAGS += -mfpu=fpv4-sp-d16 -mfloat-abi=hard
LDFLAGS += -specs=nosys.specs
LDFLAGS += -specs=nano.specs
LDFLAGS += -Wl,--gc-sections
LDFLAGS += -Wl,-Map=$(PROCESS_DIR)/output.map
LDFLAGS += -Wl,--print-memory-usage

# ── Phony targets ──
.PHONY: all clean flash

# ── Default ──
all: $(HEX) $(BIN)
	@echo ""
	@echo "[✓] 构建完成:"
	@$(SIZE) $(ELF)

# ── ELF ──
$(ELF): $(OBJS) $(LDSCRIPT)
	@mkdir -p $(BUILD_DIR)
	@echo "[LD]  $@"
	$(CC) $(OBJS) $(LDFLAGS) -o $@

# ── HEX ──
$(HEX): $(ELF)
	@echo "[HEX] $@"
	$(OBJCOPY) -O ihex $< $@

# ── BIN ──
$(BIN): $(ELF)
	@echo "[BIN] $@"
	$(OBJCOPY) -O binary $< $@

# ── Object files ──
$(PROCESS_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(PROCESS_DIR)
	@echo "[CC]  $<"
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(PROCESS_DIR)/%.o: $(SRC_DIR)/%.s
	@mkdir -p $(PROCESS_DIR)
	@echo "[AS]  $<"
	$(CC) $(CFLAGS) -c $< -o $@

# ── Clean ──
clean:
	rm -rf $(BUILD_DIR) $(PROCESS_DIR)
	@echo "[✓] 清理完成"

# ── Flash (via st-flash) ──
flash: $(BIN)
	st-flash --reset write $< 0x08000000
	@echo "[✓] 烧录完成"

# ── Debug ──
debug: $(ELF)
	$(GDB) $<
